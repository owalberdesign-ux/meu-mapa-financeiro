# URL do checkout da Kiwify. Vazia = modo prévia (o botão de compra simula o pagamento).
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL=

# Banco (Supabase, schema "mapa"). Sem as duas, o diagnóstico fica só no navegador (modo local).
SUPABASE_URL=
# Secret key do projeto (Supabase → Project Settings → API Keys). Só no servidor; nunca NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Token do webhook da Kiwify (Apps → Webhooks), para conferir a assinatura dos avisos de venda.
KIWIFY_WEBHOOK_TOKEN=

# Anúncios (opcionais). Sem ID, nada é carregado.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
